# ─────────────────────────────────────────────────────────────────────────────
# Alpaca Trading API credentials
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real keys.
# .env is listed in .gitignore and will NEVER be committed.
#
# Priority order (highest wins):
#   1. These environment variables
#   2. alpaca.api_key / alpaca.api_secret in config.json
#
# Get your keys at: https://app.alpaca.markets/paper/dashboard/overview
#   Paper trading: https://paper-api.alpaca.markets
#   Live trading:  https://api.alpaca.markets

ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here

# Set to "true" for paper trading (default), "false" for live/real-money trading.
# This overrides the "paper" flag in config.json when set.
ALPACA_PAPER=true

# ─────────────────────────────────────────────────────────────────────────────
# Massive / Polygon historical market data
# ─────────────────────────────────────────────────────────────────────────────
# Massive is the current Polygon.io API brand. Either env var is supported.

MASSIVE_API_KEY=your_massive_api_key_here
# POLYGON_API_KEY=your_legacy_polygon_api_key_here
